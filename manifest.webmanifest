{
  "name": "Spend Smart — Dépenses Smartdesignforyou",
  "short_name": "Spend Smart",
  "description": "Scanner les reçus et noter les dépenses en espèces (Rs).",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F4F6F9",
  "theme_color": "#1F4E79",
  "lang": "fr",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "fichiers", "accept": ["image/*", "application/pdf"] }]
    }
  },
  "shortcuts": [
    { "name": "Scanner une facture", "url": "./?go=scan", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Dépense sans reçu", "url": "./?go=sans", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
